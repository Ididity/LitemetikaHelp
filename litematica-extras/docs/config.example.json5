  // Hintergrund-Berechnung (läuft nie im Render-Thread)
  "scan": {
    // Radius um den Spieler für 'Umgebung' (Durchsicht, /missing near).
    // Bereich: 8 bis 256 (Standard: 48)
    "nearRadius": 48,
    // Obergrenze geprüfter Positionen pro Durchlauf (Schutz vor Rucklern).
    // Bereich: 10000 bis 50000000 (Standard: 3000000)
    "maxBlocksPerScan": 3000000,
    // Mindestabstand zwischen zwei automatischen Scans.
    // Bereich: 100 bis 60000 (Standard: 500)
    "minIntervalMs": 500,
    // Zusätzlich spätestens nach so vielen Sekunden neu prüfen (falls eine Änderung nicht gemeldet wurde).
    // Bereich: 1 bis 600 (Standard: 10)
    "fullRescanSeconds": 10
  },

  // Feature 5: Fehler durch Blöcke hindurch sehen
  "seeThrough": {
    // Modus beim Start aktiv (umschalten per Hotkey).
    "active": false,
    // own = eigener Renderer (nur Fehler, mit Reichweite/Fade/Limit), litematica = Litematicas eigene
    // 'Overlay durch Blöcke'-Option umschalten, both = beides.
    // Erlaubt: own, litematica, both
    "backend": "own",
    // Reichweite in Blöcken.
    // Bereich: 4 bis 256 (Standard: 48)
    "range": 48,
    // Maximal gezeichnete Kästen (die nächsten zuerst).
    // Bereich: 1 bis 5000 (Standard: 300)
    "maxBoxes": 300,
    // Ab dieser Entfernung wird ausgeblendet.
    // Bereich: 0 bis 256 (Standard: 24)
    "fadeStart": 24,
    // Minimale Deckkraft am Rand der Reichweite.
    // Bereich: 0 bis 1 (Standard: 0.2)
    "minAlpha": 0.2,
    // Linienstärke in GUI-Pixeln.
    // Bereich: 0.5 bis 6 (Standard: 1.0)
    "lineWidth": 1.0,
    // wire = Umrisslinien des Blocks, box = 2D-Rahmen, marker = kleines Quadrat
    // Erlaubt: wire, box, marker
    "style": "wire",
    // Im Ebenen-Modus von Litematica nur Fehler der aktuellen Ebene zeigen.
    "onlyCurrentLayer": true,
    // Fehlende Blöcke zeigen.
    "showMissing": true,
    // Falsche Blöcke zeigen.
    "showWrongType": true,
    // Falsch ausgerichtete Blöcke zeigen.
    "showWrongState": true,
    // Überzählige Blöcke zeigen.
    "showExtra": false,
    // Wie oft die Fehlerliste neu berechnet wird.
    // Bereich: 100 bis 60000 (Standard: 750)
    "updateIntervalMs": 750,
    // Farbe fehlend
    "colorMissing": "#FF55AAFF",
    // Farbe falscher Block
    "colorWrongType": "#FFFF5555",
    // Farbe falsch ausgerichtet
    "colorWrongState": "#FFFFAA00",
    // Farbe zu viel
    "colorExtra": "#FFFF55FF"
  },

  // Feature 6: KI-Assistent. Standardmäßig AUS. Sendet Spieldaten an einen externen Dienst!
  "ai": {
    // KI-Assistent aktivieren. Beim ersten Mal erscheint ein Datenschutz-Hinweis.
    "enabled": false,
    // Anbieter: anthropic, openai, gemini, ollama, openai_compatible (eigener Server mit OpenAI-Schnittstelle)
    // Erlaubt: anthropic, openai, gemini, ollama, openai_compatible
    "provider": "anthropic",
    // Modellname. Leer = Standard des Anbieters (anthropic: claude-haiku-5-5, ollama: llama3.1, sonst bitte eintragen).
    "model": "",
    // Eigene Endpoint-URL. Leer = Standard des Anbieters. Ollama: http://localhost:11434/v1/chat/completions
    "endpoint": "",
    // Optional: Name einer Umgebungsvariable, aus der der API-Key gelesen wird (statt secrets.json5).
    "apiKeyEnvVar": "",
    // Kreativität (0 = sachlich).
    // Bereich: 0 bis 2 (Standard: 0.3)
    "temperature": 0.3,
    // Temperatur mitsenden (manche Modelle lehnen sie ab).
    "sendTemperature": true,
    // Maximale Antwortlänge in Tokens.
    // Bereich: 50 bis 16000 (Standard: 700)
    "maxTokens": 700,
    // Zeitlimit pro Anfrage.
    // Bereich: 5 bis 300 (Standard: 40)
    "timeoutSeconds": 40,
    // Maximale Fragen pro Minute.
    // Bereich: 1 bis 120 (Standard: 6)
    "rateLimitPerMinute": 6,
    // Maximale Tool-Aufrufe pro Frage.
    // Bereich: 0 bis 30 (Standard: 5)
    "maxToolCalls": 5,
    // Antwortsprache.
    "answerLanguage": "Deutsch",
    // Antwortlänge: kurz, mittel, ausfuehrlich
    // Erlaubt: kurz, mittel, ausfuehrlich
    "answerLength": "kurz",
    // Verbrauchte Tokens nach jeder Antwort anzeigen.
    "showTokenUsage": true,
    // Antwort anzeigen in: chat (nur lokal), hud, both
    // Erlaubt: chat, hud, both
    "output": "chat",
    // Spieler- und Umgebungs-Tools im Multiplayer sperren (empfohlen!).
    "lockWorldToolsInMultiplayer": true,
    // Maximale Einträge in Tool-Ergebnissen.
    // Bereich: 1 bis 100 (Standard: 15)
    "topN": 15,
    // Radius für get_nearby_players.
    // Bereich: 4 bis 256 (Standard: 64)
    "playerRadius": 64,
    // Radius für get_nearby_entities.
    // Bereich: 4 bis 256 (Standard: 48)
    "entityRadius": 48,
    // Radius für find_block.
    // Bereich: 4 bis 192 (Standard: 48)
    "findBlockRadius": 48,
    // Rechenzeit-Grenze für find_block.
    // Bereich: 20 bis 5000 (Standard: 250)
    "findBlockMaxMs": 250,
    // Anzahl Zeilen für get_recent_chat.
    // Bereich: 1 bis 50 (Standard: 10)
    "chatLines": 10,

    // Was darf an die KI gesendet werden?
    "privacy": {
      // Koordinaten: exact, rounded, hidden
      // Erlaubt: exact, rounded, hidden
      "coordinates": "exact",
      // Rundung bei 'rounded'.
      // Bereich: 2 bis 1000 (Standard: 10)
      "roundTo": 10,
      // Spielernamen durch 'Spieler 1', 'Spieler 2' ersetzen.
      "anonymizePlayerNames": false,
      // Servername/-adresse an die KI senden.
      "sendServerAddress": false,
      // Inventarinhalt senden.
      "sendInventory": true,
      // Namen der Schematics senden.
      "sendSchematicNames": true,
      // Umbenannte Item-/Mob-Namen senden (als unvertraute Daten markiert).
      "sendCustomNames": false
    },

    // Tools einzeln an/aus. Standard: nur Bau-Tools an.
    "tools": {
      "get_missing_blocks": {
        // Fehlende/falsche Blöcke nach Item gezählt.
        "enabled": true,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_layer_status": {
        // Layer-Modus, Ebene, Fortschritt.
        "enabled": true,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_looked_at_block": {
        // Soll/Ist des angeschauten Blocks.
        "enabled": true,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_schematic_info": {
        // Name, Größe, Position, Fortschritt der Schematic(s).
        "enabled": true,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_material_list": {
        // Gesamtbedarf im Vergleich zum Inventar.
        "enabled": true,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_inventory": {
        // Inventar (Hotbar, Offhand, Rüstung).
        "enabled": true,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_player_status": {
        // Eigene Position, Blickrichtung, Gesundheit ...
        "enabled": false,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_nearby_players": {
        // Geladene Spieler in Reichweite. ACHTUNG: auf vielen Servern als Cheat gewertet!
        "enabled": false,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_online_players": {
        // Namen aus der Tab-Liste.
        "enabled": false,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_world_info": {
        // Zeit, Wetter, Biom, Dimension ...
        "enabled": false,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_nearby_entities": {
        // Mobs/Items/Tiere in Reichweite. ACHTUNG: auf vielen Servern als Cheat gewertet!
        "enabled": false,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "find_block": {
        // Blocktyp in geladenen Chunks suchen. ACHTUNG: auf vielen Servern als Cheat gewertet!
        "enabled": false,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_server_info": {
        // Server, Ping, Spielerzahl, Version.
        "enabled": false,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      },
      "get_recent_chat": {
        // Letzte Chatzeilen (als unvertraute Daten).
        "enabled": false,
        // Eigene Tool-Beschreibung für die KI (leer = Standard).
        "description": ""
      }
    }
  }
}

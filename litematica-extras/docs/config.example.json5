// Beispiel: so sieht config/litematica_extras/config.json5 nach dem ersten Start aus (alle Standardwerte).
// Der Mod legt die Datei selbst an – du musst sie nicht kopieren.
{
  "configVersion": 1,

  // Allgemeine Einstellungen
  "general": {
    // Sprache aller Texte des Mods (de oder en). Eigene Texte: config/litematica_extras/lang/<sprache>.json
    // Erlaubt: de, en
    "language": "de",
    // Beim Betreten einer Welt kurz den Status des Mods im Chat (nur lokal) anzeigen.
    "startupMessage": true,
    // Ausführlichere Log-Ausgaben (nie mit API-Key).
    "debugLog": false
  },

  // Befehle. Der erste Name ist der Hauptname, alle weiteren sind Aliase.
  // Änderungen an Namen greifen nach erneutem Betreten der Welt / des Servers.
  "commands": {
    "root": {
      // Präfix-Befehl, z. B. /lx reload. Erster Eintrag = Präfix.
      "names": ["lx","litextras"],
      // Präfix-Befehl aktiv.
      "enabled": true
    },
    "missing": {
      // Fehlliste ohne KI.
      "names": ["missing","fehlt"],
      // Befehl aktiv.
      "enabled": true
    },
    "ai": {
      // KI-Frage (Feature 6).
      "names": ["ai","frag"],
      // Befehl aktiv (KI selbst ist zusätzlich über ai.enabled geschaltet).
      "enabled": true
    },
    // Unterbefehle des Präfix-Befehls: interne ID -> Liste von Namen (erster = Hauptname).
    "subcommands": {
      "reload": [
        "reload",
        "neuladen"
      ],
      "config": [
        "config",
        "einstellungen"
      ],
      "profile": [
        "profile",
        "profil"
      ],
      "export": [
        "export"
      ],
      "import": [
        "import"
      ],
      "status": [
        "status"
      ],
      "similar": [
        "similar",
        "aehnlich"
      ],
      "seethrough": [
        "xray",
        "durchsicht"
      ],
      "layer": [
        "layer",
        "ebene"
      ],
      "aiconfirm": [
        "ai-confirm",
        "ki-bestaetigen"
      ],
      "help": [
        "help",
        "hilfe"
      ]
    },
    // IDs von Unterbefehlen, die ausgeschaltet sein sollen, z. B. ["import"].
    "disabledSubcommands": [],
    // Beim Betreten melden, wenn ein Befehlsname mit Vanilla/Server/anderen Mods kollidiert.
    "warnOnConflicts": true
  },

  // Eigene Kurzbefehle. Sie lösen NUR interne Mod-Funktionen oder KI-Fragen aus.
  // Server-Befehle, Chatnachrichten, Platzieren oder Bewegen sind fest verboten und nicht freischaltbar.
  "presets": {
    // Jeder Eintrag: name, aliases, und ENTWEDER action ODER aiPrompt.
    // Erlaubte actions: missing_all, missing_layer, missing_near, status, toggle_similar, toggle_seethrough,
    // toggle_hud, toggle_layerlist, reload, open_config, profile:<name>.
    // Platzhalter in aiPrompt: {scope} (aktuelle Ebene oder Schematic), {args} (Text nach dem Befehl).
    "list": [
      {
        "name": "ebenenliste",
        "aliases": [
          "el"
        ],
        "action": "missing_layer"
      },
      {
        "name": "fortschritt",
        "aliases": [],
        "action": "status"
      },
      {
        "name": "naechster",
        "aliases": [],
        "aiPrompt": "Wo ist der nächste Spieler?"
      },
      {
        "name": "wasfehlt",
        "aliases": [],
        "aiPrompt": "Welche Items fehlen mir für die {scope}? Antworte als kurze Liste."
      }
    ]
  },

  // Hotkeys (nur aktiv, wenn kein Menü/Chat offen ist).
  "hotkeys": {

    // Feature 1: Ähnliche Blöcke akzeptieren an/aus
    "toggleSimilar": {
      // Hotkey aktiv.
      "enabled": true,
      // Tastenkombination, mit + verbunden. Namen wie in GLFW: A-Z, 0-9, F1-F25, LEFT_ALT, RIGHT_ALT, LEFT_CONTROL, LEFT_SHIFT,
      // LEFT_SUPER (Cmd/Windows), KP_1, TAB, GRAVE_ACCENT, MOUSE_4 ... Leer = kein Hotkey.
      "keys": "LEFT_ALT+J",
      // toggle = Drücken schaltet um, hold = nur aktiv solange gedrückt.
      // Erlaubt: toggle, hold
      "mode": "toggle"
    },

    // Feature 5: Fehler durch Blöcke sehen an/aus
    "toggleSeeThrough": {
      // Hotkey aktiv.
      "enabled": true,
      // Tastenkombination, mit + verbunden. Namen wie in GLFW: A-Z, 0-9, F1-F25, LEFT_ALT, RIGHT_ALT, LEFT_CONTROL, LEFT_SHIFT,
      // LEFT_SUPER (Cmd/Windows), KP_1, TAB, GRAVE_ACCENT, MOUSE_4 ... Leer = kein Hotkey.
      "keys": "LEFT_ALT+K",
      // toggle = Drücken schaltet um, hold = nur aktiv solange gedrückt.
      // Erlaubt: toggle, hold
      "mode": "toggle"
    },

    // Gesamtes HUD des Mods an/aus
    "toggleHud": {
      // Hotkey aktiv.
      "enabled": true,
      // Tastenkombination, mit + verbunden. Namen wie in GLFW: A-Z, 0-9, F1-F25, LEFT_ALT, RIGHT_ALT, LEFT_CONTROL, LEFT_SHIFT,
      // LEFT_SUPER (Cmd/Windows), KP_1, TAB, GRAVE_ACCENT, MOUSE_4 ... Leer = kein Hotkey.
      "keys": "LEFT_ALT+H",
      // toggle = Drücken schaltet um, hold = nur aktiv solange gedrückt.
      // Erlaubt: toggle, hold
      "mode": "toggle"
    },

    // Feature 4: Ebenen-Fehlliste an/aus
    "toggleLayerList": {
      // Hotkey aktiv.
      "enabled": true,
      // Tastenkombination, mit + verbunden. Namen wie in GLFW: A-Z, 0-9, F1-F25, LEFT_ALT, RIGHT_ALT, LEFT_CONTROL, LEFT_SHIFT,
      // LEFT_SUPER (Cmd/Windows), KP_1, TAB, GRAVE_ACCENT, MOUSE_4 ... Leer = kein Hotkey.
      "keys": "LEFT_ALT+L",
      // toggle = Drücken schaltet um, hold = nur aktiv solange gedrückt.
      // Erlaubt: toggle, hold
      "mode": "toggle"
    },

    // Nächstes Config-Profil
    "cycleProfile": {
      // Hotkey aktiv.
      "enabled": true,
      // Tastenkombination, mit + verbunden. Namen wie in GLFW: A-Z, 0-9, F1-F25, LEFT_ALT, RIGHT_ALT, LEFT_CONTROL, LEFT_SHIFT,
      // LEFT_SUPER (Cmd/Windows), KP_1, TAB, GRAVE_ACCENT, MOUSE_4 ... Leer = kein Hotkey.
      "keys": "LEFT_ALT+P",
      // toggle = Drücken schaltet um, hold = nur aktiv solange gedrückt.
      // Erlaubt: toggle, hold
      "mode": "toggle"
    },

    // Config neu laden
    "reloadConfig": {
      // Hotkey aktiv.
      "enabled": true,
      // Tastenkombination, mit + verbunden. Namen wie in GLFW: A-Z, 0-9, F1-F25, LEFT_ALT, RIGHT_ALT, LEFT_CONTROL, LEFT_SHIFT,
      // LEFT_SUPER (Cmd/Windows), KP_1, TAB, GRAVE_ACCENT, MOUSE_4 ... Leer = kein Hotkey.
      "keys": "LEFT_ALT+R",
      // toggle = Drücken schaltet um, hold = nur aktiv solange gedrückt.
      // Erlaubt: toggle, hold
      "mode": "toggle"
    },

    // Einstellungs-Fenster öffnen
    "openConfig": {
      // Hotkey aktiv.
      "enabled": true,
      // Tastenkombination, mit + verbunden. Namen wie in GLFW: A-Z, 0-9, F1-F25, LEFT_ALT, RIGHT_ALT, LEFT_CONTROL, LEFT_SHIFT,
      // LEFT_SUPER (Cmd/Windows), KP_1, TAB, GRAVE_ACCENT, MOUSE_4 ... Leer = kein Hotkey.
      "keys": "LEFT_ALT+O",
      // toggle = Drücken schaltet um, hold = nur aktiv solange gedrückt.
      // Erlaubt: toggle, hold
      "mode": "toggle"
    },

    // Fehlliste (Ebene oder Umgebung) im Chat anzeigen
    "missingList": {
      // Hotkey aktiv.
      "enabled": true,
      // Tastenkombination, mit + verbunden. Namen wie in GLFW: A-Z, 0-9, F1-F25, LEFT_ALT, RIGHT_ALT, LEFT_CONTROL, LEFT_SHIFT,
      // LEFT_SUPER (Cmd/Windows), KP_1, TAB, GRAVE_ACCENT, MOUSE_4 ... Leer = kein Hotkey.
      "keys": "LEFT_ALT+M",
      // toggle = Drücken schaltet um, hold = nur aktiv solange gedrückt.
      // Erlaubt: toggle, hold
      "mode": "toggle"
    }
  },

  // Farben im Format #RRGGBB oder #AARRGGBB
  "colors": {
    // Richtig
    "correct": "#55FF55",
    // Ähnlich (akzeptiert)
    "similar": "#A8FFA8",
    // Falsch
    "wrong": "#FF5555",
    // Fehlt
    "missing": "#55AAFF",
    // Zu viel (Block steht, wo Luft geplant ist)
    "extra": "#FF55FF",
    // Warnung
    "warning": "#FFFF55",
    // Normaler Text
    "text": "#FFFFFF",
    // Nebeninfo
    "neutral": "#AAAAAA",
    // Rahmen um passenden Hotbar-Slot
    "hotbarHighlight": "#C055FF55",
    // Hintergrund des passenden Hotbar-Slots
    "hotbarHighlightFill": "#4055FF55"
  },

  // Textvorlagen. Platzhalter in geschweiften Klammern.
  // Allgemein: {soll}, {ist}, {abweichungen}, {block}, {props}, {status}, {item}, {slot}, {need}, {have}, {fehl}, {layer}, {count}, {result}, {pos}
  "templates": {
    // Statuszeile, z. B. 'Typ ok, Richtung falsch'.
    "status": "{status}",
    // Soll-Zeile. {props} wird pro Property einzeln eingefärbt.
    "soll": "Soll: {block}{props}",
    // Ist-Zeile.
    "ist": "Ist: {block}{props}",
    // Zeile mit allen Abweichungen.
    "diff": "Abweichungen: {abweichungen}",
    // Kompakte Einzeile (Zeilen-ID 'compact').
    "compact": "Soll: {soll} / Ist: {ist}",
    // Text vor der ersten Property.
    "propsPrefix": ", ",
    // Format einer Property.
    "propFormat": "{name}: {value}",
    // Trenner zwischen Properties.
    "propSeparator": ", ",
    // Platzier-Vorschau (Feature 2).
    "preview": "Vorschau: {result}",
    // Feature 3: Item in der Hotbar.
    "neededHotbar": "{item} (Hotbar {slot})",
    // Feature 3: Item nur im Inventar.
    "neededInventory": "{item} (Inventar, Slot {slot})",
    // Feature 3: Item nicht vorhanden.
    "neededMissing": "{item} fehlt",
    // Feature 4: Kopfzeile.
    "layerHeader": "{layer}: {count} Fehler",
    // Feature 4: Zeile. {fehltext} wird nur bei Fehlbetrag gefüllt.
    "layerLine": "{item} {have}/{need}{fehltext}",
    // Feature 4: Text für Fehlbetrag.
    "layerShortfall": " (-{fehl})",
    // Fehlliste im Chat (/missing).
    "chatMissingLine": "{need}x {item} (hast {have}){fehltext}"
  },

  // HUD-Grundeinstellungen
  "hud": {
    // Gesamtes HUD des Mods.
    "enabled": true,
    // Text mit Schatten.
    "textShadow": true,
    // Wie oft (in Ticks) der angeschaute Block neu bewertet wird. 20 Ticks = 1 Sekunde.
    // Bereich: 1 bis 40 (Standard: 2)
    "updateIntervalTicks": 2,

    // Feature 2: Soll/Ist des angeschauten Blocks
    "lookedAt": {
      // Dieses HUD-Element anzeigen.
      "enabled": true,
      // Ecke: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      // Erlaubt: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      "anchor": "bottom_left",
      // Pixel-Versatz horizontal (positiv = nach rechts).
      // Bereich: -4000 bis 4000 (Standard: 4)
      "offsetX": 4,
      // Pixel-Versatz vertikal (positiv = nach unten).
      // Bereich: -4000 bis 4000 (Standard: -4)
      "offsetY": -4,
      // Größe/Schriftgröße (1.0 = normal).
      // Bereich: 0.25 bis 4 (Standard: 1.0)
      "scale": 1.0,
      // Hintergrundkasten zeichnen.
      "background": true,
      // Hintergrundfarbe #AARRGGBB (AA = Transparenz).
      "backgroundColor": "#90000000",
      // Innenabstand in Pixeln.
      // Bereich: 0 bis 20 (Standard: 3)
      "padding": 3,
      // Maximale Anzahl Zeilen.
      // Bereich: 1 bis 100 (Standard: 8)
      "maxLines": 8,
      // Reihenfolge/Sichtbarkeit der Zeilen: status, soll, ist, diff, compact, pos
      "lines": ["status","soll","ist","diff"],
      // Nur anzeigen, wenn der Block zur Schematic gehört (oder dort stört).
      "onlyInSchematic": true,
      // Nur falsche Properties rot färben (sonst ganze Zeile).
      "onlyWrongPropsRed": true,
      // Auch ignorierte Properties anzeigen.
      "showAllProps": false
    },

    // Feature 2: Platzier-Vorschau (vor dem Platzieren)
    "preview": {
      // Dieses HUD-Element anzeigen.
      "enabled": true,
      // Ecke: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      // Erlaubt: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      "anchor": "bottom_left",
      // Pixel-Versatz horizontal (positiv = nach rechts).
      // Bereich: -4000 bis 4000 (Standard: 4)
      "offsetX": 4,
      // Pixel-Versatz vertikal (positiv = nach unten).
      // Bereich: -4000 bis 4000 (Standard: -80)
      "offsetY": -80,
      // Größe/Schriftgröße (1.0 = normal).
      // Bereich: 0.25 bis 4 (Standard: 1.0)
      "scale": 1.0,
      // Hintergrundkasten zeichnen.
      "background": true,
      // Hintergrundfarbe #AARRGGBB (AA = Transparenz).
      "backgroundColor": "#90000000",
      // Innenabstand in Pixeln.
      // Bereich: 0 bis 20 (Standard: 3)
      "padding": 3,
      // Maximale Anzahl Zeilen.
      // Bereich: 1 bis 100 (Standard: 3)
      "maxLines": 3,
      // Nur anzeigen, wenn ein Block in der Hand ist.
      "onlyWithBlockInHand": true
    },

    // Feature 3: Benötigtes Item
    "neededItem": {
      // Dieses HUD-Element anzeigen.
      "enabled": true,
      // Ecke: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      // Erlaubt: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      "anchor": "bottom_center",
      // Pixel-Versatz horizontal (positiv = nach rechts).
      // Bereich: -4000 bis 4000 (Standard: 0)
      "offsetX": 0,
      // Pixel-Versatz vertikal (positiv = nach unten).
      // Bereich: -4000 bis 4000 (Standard: -60)
      "offsetY": -60,
      // Größe/Schriftgröße (1.0 = normal).
      // Bereich: 0.25 bis 4 (Standard: 1.0)
      "scale": 1.0,
      // Hintergrundkasten zeichnen.
      "background": true,
      // Hintergrundfarbe #AARRGGBB (AA = Transparenz).
      "backgroundColor": "#90000000",
      // Innenabstand in Pixeln.
      // Bereich: 0 bis 20 (Standard: 3)
      "padding": 3,
      // Maximale Anzahl Zeilen.
      // Bereich: 1 bis 100 (Standard: 4)
      "maxLines": 4,
      // Passenden Hotbar-Slot einrahmen.
      "highlightHotbar": true,
      // Nur anzeigen, wenn der angeschaute Block fehlt oder falsch ist.
      "onlyWhenIncorrect": true,
      // Automatisch auf den passenden Hotbar-Slot wechseln.
      "autoSwitch": false,
      // Wartezeit, bevor automatisch gewechselt wird.
      // Bereich: 0 bis 40 (Standard: 4)
      "autoSwitchDelayTicks": 4
    },

    // Feature 4: Fehlliste der aktuellen Ebene
    "layerList": {
      // Dieses HUD-Element anzeigen.
      "enabled": true,
      // Ecke: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      // Erlaubt: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      "anchor": "top_left",
      // Pixel-Versatz horizontal (positiv = nach rechts).
      // Bereich: -4000 bis 4000 (Standard: 4)
      "offsetX": 4,
      // Pixel-Versatz vertikal (positiv = nach unten).
      // Bereich: -4000 bis 4000 (Standard: 40)
      "offsetY": 40,
      // Größe/Schriftgröße (1.0 = normal).
      // Bereich: 0.25 bis 4 (Standard: 1.0)
      "scale": 1.0,
      // Hintergrundkasten zeichnen.
      "background": true,
      // Hintergrundfarbe #AARRGGBB (AA = Transparenz).
      "backgroundColor": "#90000000",
      // Innenabstand in Pixeln.
      // Bereich: 0 bis 20 (Standard: 3)
      "padding": 3,
      // Maximale Anzahl Zeilen.
      // Bereich: 1 bis 100 (Standard: 12)
      "maxLines": 12,
      // Nur zeigen, wenn Litematica auf 'Einzelne Ebene' oder 'Ebenenbereich' steht.
      "onlyInLayerMode": true,
      // Sortierung: shortfall (Fehlbetrag), amount (Menge), name
      // Erlaubt: shortfall, amount, name
      "sort": "shortfall",
      // Gedrosselte Neuberechnung in Millisekunden.
      // Bereich: 250 bis 60000 (Standard: 1500)
      "updateIntervalMs": 1500,
      // Falsch gedrehte Blöcke mitzählen (müssen neu platziert werden).
      "includeWrongState": true,
      // Falsche Blöcke mitzählen.
      "includeWrongType": true
    },

    // Kleine Statusanzeige (aktive Modi, Profil)
    "status": {
      // Dieses HUD-Element anzeigen.
      "enabled": true,
      // Ecke: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      // Erlaubt: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      "anchor": "top_right",
      // Pixel-Versatz horizontal (positiv = nach rechts).
      // Bereich: -4000 bis 4000 (Standard: -4)
      "offsetX": -4,
      // Pixel-Versatz vertikal (positiv = nach unten).
      // Bereich: -4000 bis 4000 (Standard: 4)
      "offsetY": 4,
      // Größe/Schriftgröße (1.0 = normal).
      // Bereich: 0.25 bis 4 (Standard: 1.0)
      "scale": 1.0,
      // Hintergrundkasten zeichnen.
      "background": true,
      // Hintergrundfarbe #AARRGGBB (AA = Transparenz).
      "backgroundColor": "#90000000",
      // Innenabstand in Pixeln.
      // Bereich: 0 bis 20 (Standard: 3)
      "padding": 3,
      // Maximale Anzahl Zeilen.
      // Bereich: 1 bis 100 (Standard: 4)
      "maxLines": 4
    },

    // Feature 6: KI-Antwort im HUD
    "aiAnswer": {
      // Dieses HUD-Element anzeigen.
      "enabled": true,
      // Ecke: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      // Erlaubt: top_left, top_center, top_right, middle_left, center, middle_right, bottom_left, bottom_center, bottom_right
      "anchor": "middle_right",
      // Pixel-Versatz horizontal (positiv = nach rechts).
      // Bereich: -4000 bis 4000 (Standard: -4)
      "offsetX": -4,
      // Pixel-Versatz vertikal (positiv = nach unten).
      // Bereich: -4000 bis 4000 (Standard: 0)
      "offsetY": 0,
      // Größe/Schriftgröße (1.0 = normal).
      // Bereich: 0.25 bis 4 (Standard: 1.0)
      "scale": 1.0,
      // Hintergrundkasten zeichnen.
      "background": true,
      // Hintergrundfarbe #AARRGGBB (AA = Transparenz).
      "backgroundColor": "#90000000",
      // Innenabstand in Pixeln.
      // Bereich: 0 bis 20 (Standard: 3)
      "padding": 3,
      // Maximale Anzahl Zeilen.
      // Bereich: 1 bis 100 (Standard: 14)
      "maxLines": 14,
      // Wie lange die Antwort sichtbar bleibt.
      // Bereich: 3 bis 600 (Standard: 30)
      "showSeconds": 30,
      // Zeilenumbruch-Breite in Pixeln.
      // Bereich: 80 bis 600 (Standard: 220)
      "wrapWidth": 220
    }
  },

  // Vergleichslogik Soll (Schematic) gegen Ist (Welt) – gilt für ALLE Anzeigen.
  "compare": {
    "similar": {
      // Feature 1: Ähnliche Blöcke akzeptieren (Typ wird gelockert, Properties bleiben streng).
      "enabled": false,
      // Alle soliden Vollblöcke ohne Redstone-Eigenschaften gelten untereinander als gleichwertig.
      "solidBlocks": true,
      // Diese Blöcke/Tags zählen NIE als 'solider Block' (zusätzlich zur automatischen Redstone-/BlockEntity-Prüfung).
      "solidBlacklist": [
        "minecraft:observer",
        "minecraft:piston",
        "minecraft:sticky_piston",
        "minecraft:redstone_block",
        "minecraft:target",
        "minecraft:dispenser",
        "minecraft:dropper",
        "minecraft:note_block",
        "minecraft:tnt",
        "minecraft:redstone_lamp",
        "minecraft:slime_block",
        "minecraft:honey_block",
        "minecraft:crafter",
        "minecraft:spawner",
        "#minecraft:leaves",
        "#minecraft:shulker_boxes",
        "minecraft:budding_amethyst"
      ],
      // Properties, die beim Tausch zweier solider Blöcke fehlen dürfen (z. B. "axis" für Stamm -> Stein).
      "solidAllowMissingProperties": []
    },
    // Diese Properties werden NIE verglichen. waterlogged ist absichtlich NICHT drin, kann aber ergänzt werden.
    "ignoredProperties": ["powered","lit","age","distance","persistent","snowy"],
    // Die Ignorierliste auch dann anwenden, wenn 'Ähnliche Blöcke' aus ist.
    "ignoredPropertiesAlsoWhenExact": true,
    // Was als 'Ausrichtung' gilt (für propertyMode orientation_only).
    "orientationProperties": [
      "facing",
      "axis",
      "rotation",
      "orientation",
      "half",
      "type",
      "shape",
      "face",
      "hinge",
      "attachment",
      "horizontal_facing",
      "vertical_direction"
    ],
    // Blöcke, wo die Schematic Luft hat, als Fehler ('zu viel') melden.
    "reportExtra": true,
    // Äquivalenzgruppen für Feature 1. members: Block-IDs oder Tags (#minecraft:stairs).
    // propertyMode: strict (alle Properties außer Ignorierliste), orientation_only (nur Ausrichtung/Position), ignore (keine).
    // Optional: allowMissingProperties: ["axis"] = diese dürfen beim Ist-Block fehlen. Optional: enabled: false.
    "groups": [
      {
        "name": "Treppen",
        "members": [
          "#minecraft:stairs"
        ],
        "propertyMode": "strict"
      },
      {
        "name": "Stufen",
        "members": [
          "#minecraft:slabs"
        ],
        "propertyMode": "strict"
      },
      {
        "name": "Zäune",
        "members": [
          "#minecraft:fences"
        ],
        "propertyMode": "strict"
      },
      {
        "name": "Zauntore",
        "members": [
          "#minecraft:fence_gates"
        ],
        "propertyMode": "strict"
      },
      {
        "name": "Mauern",
        "members": [
          "#minecraft:walls"
        ],
        "propertyMode": "strict"
      },
      {
        "name": "Holztüren",
        "members": [
          "#minecraft:wooden_doors"
        ],
        "propertyMode": "strict"
      },
      {
        "name": "Holzfalltüren",
        "members": [
          "#minecraft:wooden_trapdoors"
        ],
        "propertyMode": "strict"
      },
      {
        "name": "Stämme",
        "members": [
          "#minecraft:logs"
        ],
        "propertyMode": "strict"
      },
      {
        "name": "Bretter",
        "members": [
          "#minecraft:planks"
        ],
        "propertyMode": "strict"
      },
      {
